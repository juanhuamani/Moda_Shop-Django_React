# URL base de la API. Dejar VACIA para usar el mismo origen (proxy de Vite en
# desarrollo, proxy del servidor en produccion). Si se define, debe ser una URL
# absoluta http(s) sin barra final; solo es una salida de emergencia para
# desarrollo contra un backend remoto.
VITE_API_URL=

# URL base de los archivos de media (avatares, imagenes de producto).
# Dejar VACIA para servirlos desde el mismo origen.
VITE_MEDIA_URL=
