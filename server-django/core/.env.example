# ---------------------------------------------------------------------------
# Copy this file to .env and fill SECRET_KEY:
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
#
# Generate SECRET_KEY (run once, paste the result below):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Keys marked "default: ..." are optional: leave them commented out to use the
# stated default. An empty value is not the same as an absent one, so do not
# enable a key without a value.
# ---------------------------------------------------------------------------

# Django core. DEBUG=1 for local dev; DEBUG=0 in production (then ALLOWED_HOSTS
# must list the real host names, otherwise Django refuses to start).
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins allowed to call the API cross-origin.
# default: empty = same-origin only (the recommended topology: the SPA and the
# API share one origin, so no CORS headers are needed).
#CORS_ALLOWED_ORIGINS=

# Comma separated full scheme://host[:port] origins trusted for CSRF and for the
# request origin guard. default: empty.
#CSRF_TRUSTED_ORIGINS=

# SQLite busy timeout in seconds. default: 20
#DATABASE_TIMEOUT=20

# Token lifetimes, in minutes and in days. default: 30 / 1
#ACCESS_TOKEN_LIFETIME=30
#REFRESH_TOKEN_LIFETIME=1

# Auth cookie flags. JWT_COOKIE_SECURE default: true when DEBUG=0, false when
# DEBUG=1. JWT_COOKIE_SAMESITE default: Lax.
#JWT_COOKIE_SECURE=True
#JWT_COOKIE_SAMESITE=Lax

# Django's own CSRF cookie flag. default: true when DEBUG=0, false when DEBUG=1.
#CSRF_COOKIE_SECURE=True

# Uploaded media (avatars, product images) on disk.
# default: <server-django/core>/media
#MEDIA_ROOT=/var/lib/moda-shop/media

# Set to True only when a reverse proxy terminates TLS / forwards the host and
# the browser reaches Django through it. default: False for both.
#USE_X_FORWARDED_HOST=True
#USE_X_FORWARDED_PROTO=True
